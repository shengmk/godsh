{
    "$schema":  "../node_modules/@tauri-apps/cli/config.schema.json",
    "productName":  "godsh",
    "version":  "0.2.6",
    "identifier":  "com.godsh.app",
    "build":  {
                  "frontendDist":  "../../shell-web/dist",
                  "devUrl":  "http://localhost:5173",
                  "beforeDevCommand":  "pnpm --filter @godsh/shell-web dev",
                  "beforeBuildCommand":  "pnpm --filter @godsh/shell-web build:tauri"
              },
    "app":  {
                "windows":  [
                                {
                                    "title":  "godsh",
                                    "width":  1100,
                                    "height":  720,
                                    "minWidth":  900,
                                    "minHeight":  600,
                                    "resizable":  true,
                                    "fullscreen":  false
                                }
                            ],
                "security":  {
                                 "csp":  null
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  "all",
                   "resources":  [
                                     "resources"
                                 ],
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ],
                   "android":  {
                                   "debugApplicationIdSuffix":  ".debug"
                               }
               }
}